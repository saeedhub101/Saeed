{
  "id": "llm-llamacpp",
  "name": "Local brain (Qwen / Llama / any GGUF)",
  "version": "1.0.2",
  "author": "Saeed",
  "category": "brain",
  "bundle": "none",
  "description": "Optional local AI brain (Qwen / Llama / GGUF). Downloaded separately from Saeed and loaded only when selected. Runs on this PC without cloud API fees; the selected model downloads on first use and is stored outside the app installation.",
  "main": "index.js",
  "permissions": [],
  "idleSeconds": 120,
  "provides": {
    "llm": {
      "label": "Local model"
    }
  },
  "settings": [
    {
      "key": "modelChoice",
      "label": "Choose local model",
      "type": "select",
      "default": "qwen3-4b",
      "options": [
        [
          "qwen3-0.6b",
          "Qwen3 0.6B — tiny / lighter (~0.43 GB)"
        ],
        [
          "qwen3-4b",
          "Qwen3 4B — stronger (~2.5 GB)"
        ]
      ]
    },
    {
      "key": "modelUrl",
      "label": "Custom GGUF URL (optional; overrides the preset)",
      "type": "text",
      "default": ""
    },
    {
      "key": "modelPath",
      "label": "Or use a model file already on this PC",
      "type": "text",
      "default": ""
    },
    {
      "key": "contextSize",
      "label": "Memory of the conversation (tokens)",
      "type": "number",
      "default": 4096
    },
    {
      "key": "maxTokens",
      "label": "Longest answer (tokens)",
      "type": "number",
      "default": 600
    }
  ]
}
