{
  "name": "avatar-agent",
  "productName": "Avatar Agent",
  "version": "0.1.0",
  "description": "Desktop 3D avatar: transparent character window, tray app, and a studio for bones, poses and motions.",
  "main": "src/main/main.js",
  "author": "Saeed",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.avataragent.app",
    "productName": "Avatar Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "package.json",
      "node_modules/three/**",
    "node_modules/three/examples/jsm/**",
      "!node_modules/three/src/**",
      "!node_modules/three/examples/jsm/libs/**",
      "!node_modules/three/examples/{fonts,models,textures,screenshots}/**",
      "!node_modules/three/build/{three.cjs,three.min.js,three.module.min.js}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Avatar Agent"
    },
    "asar": true
  }
}
