
{
  "name": "avatar-agent-lifecycle-pro",
  "version": "2.1.0",
  "description": "Saeed Pro Desktop - Lifecycle Optimized General Task Automation Agent",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "build": "electron-builder --win",
    "predist": "node scripts/vendor.js",
    "dist": "electron-builder --win nsis",
    "build-addons": "node scripts/build-addons.js"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "three": "^0.170.0",
    "adm-zip": "^0.5.16"
  },
  "build": {
    "appId": "com.saeed.lifecycle.pro",
    "productName": "SaeedPro Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!dist-addons/**",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}

