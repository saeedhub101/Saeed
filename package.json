
{
  "name": "avatar-agent-lifecycle-pro",
  "version": "2.1.0",
  "description": "Saeed Pro Desktop - Lifecycle Optimized General Task Automation Agent",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "build": "electron-builder --win",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron": "^28.0.0"
  },
  "devDependencies": {
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.saeed.lifecycle.pro",
    "productName": "SaeedPro Desktop",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}

